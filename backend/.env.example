PORT=3000

# Ambil di Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Buat fitur login admin -- isi dengan string acak yang panjang & rahasia
JWT_SECRET=ganti_dengan_string_acak_yang_panjang_dan_rahasia

# Buat fitur chatbot AI (Gemini API -- GRATIS, ambil di https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here
